# Copy this file to .env.local and fill in the values.

# Free key from https://aistudio.google.com/apikey — powers the "Ask my AI" chatbot.
# Without it, the chatbot still works using simple built-in answers.
GEMINI_API_KEY=

# Optional: change the Gemini model
# GEMINI_MODEL=gemini-2.5-flash

# Free form ID from https://formspree.io (the part after /f/ in your form URL).
# Without it, the contact form opens the visitor's email app instead.
NEXT_PUBLIC_FORMSPREE_ID=
